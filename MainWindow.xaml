<Window x:Class="XiaoMiaoWinUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Win7/10/11 自动更新关闭工具"
        Width="640"
        Height="520"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Icon="pack://application:,,,/icon.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Win7/10/11 自动更新关闭工具"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A1A1A"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="作者：小喵软件"
                       FontSize="12"
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>

        <!-- 当前系统 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Status.OsCaption}"
                   FontSize="13"
                   Foreground="#333333"
                   Margin="0,14,0,0"/>

        <!-- 功能说明 -->
        <TextBlock Grid.Row="2"
                   Text="关闭 Windows 自动更新、更新通知、更新自动重启和 Windows Update 驱动更新，并禁止通过 Windows Update 手动下载或安装更新。"
                   FontSize="13"
                   Foreground="#333333"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <!-- 状态卡片 -->
        <Border Grid.Row="3"
                Background="#FFF9F0"
                BorderBrush="#FFE0B3"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,16,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="状态："
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#B85C00"
                               VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status.StatusHeading}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{Binding Status.StatusHeadingBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </Grid>

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.AutoUpdate.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.AutoUpdate.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.AutoUpdate.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.UpdateNotification.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.UpdateNotification.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.UpdateNotification.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.AutoRestart.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.AutoRestart.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.AutoRestart.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.DriverUpdate.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.DriverUpdate.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.DriverUpdate.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.ManualAccess.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.ManualAccess.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.ManualAccess.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Width="260" Margin="0,3">
                        <TextBlock Text="{Binding Status.ExtraBlock.Label}" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="：" FontSize="13" Foreground="#333333"/>
                        <TextBlock Text="{Binding Status.ExtraBlock.ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Status.ExtraBlock.ValueBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding Status.StatusSubText}"
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 按钮行 -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="BtnDisable"
                    Content="彻底关闭 Windows 更新"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnDisable_Click"
                    Height="44"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="1"
                    x:Name="BtnRestore"
                    Content="恢复到运行本软件前的状态"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="BtnRestore_Click"
                    Height="44"
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- 底部说明 -->
        <Border Grid.Row="5"
                Background="#FFFBE6"
                BorderBrush="#FFE58F"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,18,0,0">
            <TextBlock Text="注意：关闭后 Windows 不会按正常自动更新流程获取系统安全补丁和 Windows Update 驱动更新。Windows Update 页面将不再提供手动检查、下载或安装更新的入口。&#x0a;「恢复」只恢复本软件第一次运行前保存的本机更新策略状态。"
                       FontSize="12"
                       Foreground="#8C6B1F"
                       TextWrapping="Wrap"
                       LineHeight="18"/>
        </Border>
    </Grid>
</Window>
